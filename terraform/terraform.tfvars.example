# Copy to terraform.tfvars and replace every placeholder.
# terraform.tfvars contains credentials and must remain ignored by Git.
# Never place a private SSH key in this file.

proxmox_api_url          = "https://PROXMOX-MANAGEMENT-IP:8006/api2/json"
proxmox_api_token_id     = "terraform-user@pve!homelab"
proxmox_api_token_secret = "REPLACE_WITH_PROXMOX_TOKEN_SECRET"
proxmox_insecure         = true

pve_iso_datastore = "local"
pve_vm_datastore  = "local-lvm"

# Verify the current Fedora Cloud image URL before a new deployment.
os_image_url      = "https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
os_image_filename = "fedora-cloud-base.qcow2"

vm_disk_size = 30
ssh_username = "YOUR_ADMIN_USERNAME"

# Use the public key that matches the controller's private key.
# A normal OpenSSH key and a FIDO2/YubiKey-backed *.pub key both work.
ssh_public_keys = [
  "REPLACE_WITH_COMPLETE_OPENSSH_PUBLIC_KEY_LINE",
]

network_gateway = "192.168.0.1"
network_bridge  = "vmbr0"

k8s_nodes = {
  k8s-worker-01 = {
    node   = "pve1"
    vmid   = 150
    ip     = "192.168.0.50/24"
    cores  = 4
    memory = 8192
  }

  k8s-worker-02 = {
    node   = "pve2"
    vmid   = 151
    ip     = "192.168.0.51/24"
    cores  = 4
    memory = 8192
  }

  k8s-master-01 = {
    node   = "pve3"
    vmid   = 152
    ip     = "192.168.0.52/24"
    cores  = 4
    memory = 8192
  }
}
