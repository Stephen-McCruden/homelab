# FILE PATH: ansible/platform-bootstrap.env.example
# PURPOSE: Document environment variables used by platform-bootstrap.yml.
#
# Do not place a real GitHub token in this tracked file.
# The recommended token workflow is interactive:
#
#   read -rsp "GitHub fine-grained token: " GITHUB_TOKEN
#   printf '\n'
#   export GITHUB_TOKEN
#
#   ansible-playbook playbooks/platform-bootstrap.yml
#   # or:
#   ../scripts/ansible-yubikey playbooks/platform-bootstrap.yml
#
#   unset GITHUB_TOKEN
#
# GITHUB_TOKEN is required only when Flux is not already bootstrapped.
#
# Optional: override the default SOPS age key path.
# The default is $HOME/.config/sops/age/keys.txt.
#
# export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
#
# Optional: override the YubiKey-backed SSH key used by the wrapper.
# The default is $HOME/.ssh/id_ed25519_sk.
#
# export ANSIBLE_YUBIKEY_PATH="$HOME/.ssh/id_ed25519_sk"
